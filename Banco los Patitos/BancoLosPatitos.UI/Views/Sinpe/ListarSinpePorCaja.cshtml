@model List<BancoLosPatitos.Abstracciones.ModelosParaUI.SinpeDto>

@{
    ViewBag.Title = "SINPE de la caja";
}

<h2>SINPE recibidos</h2>

<p><strong>Caja:</strong> @ViewBag.NombreDeLaCaja</p>
<p><strong>Teléfono SINPE:</strong> @ViewBag.TelefonoSINPE</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="mb-3">
    @Html.ActionLink(
        "Volver a cajas",
        "ListarCajas",
        "Caja",
        new { idComercio = ViewBag.IdComercio },
        new { @class = "btn btn-secondary btn-sm" }
    )
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Teléfono origen</th>
                <th>Nombre origen</th>
                <th>Teléfono destinatario</th>
                <th>Nombre destinatario</th>
                <th>Monto</th>
                <th>Descripción</th>
                <th>Fecha</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center">Esta caja no ha recibido SINPE.</td>
                </tr>
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TelefonoOrigen</td>
                    <td>@item.NombreOrigen</td>
                    <td>@item.TelefonoDestinatario</td>
                    <td>@item.NombreDestinatario</td>
                    <td class="text-end">@item.MontoTexto</td>
                    <td>@item.Descripcion</td>
                    <td>@item.FechaDeRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">@item.EstadoTexto</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.EstadoTexto</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
