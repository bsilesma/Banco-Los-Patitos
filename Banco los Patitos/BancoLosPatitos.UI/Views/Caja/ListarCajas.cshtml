@model List<BancoLosPatitos.Abstracciones.ModelosParaUI.CajaDto>

@{
    ViewBag.Title = "Cajas";
}

<h2>Cajas</h2>

<p><strong>Comercio:</strong> @ViewBag.NombreDelComercio</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="mb-3">
    @Html.ActionLink(
        "Registrar caja",
        "RegistrarCaja",
        "Caja",
        new { idComercio = ViewBag.IdComercio },
        new { @class = "btn btn-primary btn-sm" }
    )

    @Html.ActionLink(
        "Volver a comercios",
        "ListarComercios",
        "Comercio",
        null,
        new { @class = "btn btn-secondary btn-sm" }
    )
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Teléfono SINPE</th>
                <th>Fecha de registro</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">Este comercio no tiene cajas registradas.</td>
                </tr>
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.DescripcionCorta</td>
                    <td>@item.TelefonoSINPE</td>
                    <td>@item.FechaDeRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">@item.EstadoTexto</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.EstadoTexto</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        @Html.ActionLink(
                            "Editar",
                            "EditarCaja",
                            "Caja",
                            new { id = item.IdCaja },
                            new { @class = "btn btn-warning btn-sm" }
                        )

                        @Html.ActionLink(
                            "Ver SINPE",
                            "ListarSinpePorCaja",
                            "Sinpe",
                            new { id = item.IdCaja },
                            new { @class = "btn btn-info btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
