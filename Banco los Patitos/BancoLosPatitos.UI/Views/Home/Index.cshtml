@{
    ViewBag.Title = "Inicio";
}

<main>
    <section class="row" aria-labelledby="title">
        <h1 id="title">Banco Los Patitos</h1>
        <p class="lead">SINPE Empresarial: la plataforma para que su comercio confirme, caja por caja, cada pago recibido por SINPE Móvil.</p>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="comerciosTitle">
            <h2 id="comerciosTitle">Comercios</h2>
            <p>Afilie su comercio y administre las cajas que reciben pagos, cada una con su propio teléfono SINPE.</p>
            <p>@Html.ActionLink("Ver comercios", "ListarComercios", "Comercio", null, new { @class = "btn btn-outline-dark" })</p>
        </section>
        <section class="col-md-4" aria-labelledby="sinpeTitle">
            <h2 id="sinpeTitle">SINPE</h2>
            <p>Registre pagos electrónicos hacia las cajas activas y consulte los SINPE que recibió cada una.</p>
            <p>@Html.ActionLink("Registrar SINPE", "RegistrarSinpe", "Sinpe", null, new { @class = "btn btn-outline-dark" })</p>
        </section>
        <section class="col-md-4" aria-labelledby="bitacoraTitle">
            <h2 id="bitacoraTitle">Bitácora</h2>
            <p>Cada registro, edición y error queda guardado con la fecha y los datos antes y después del cambio.</p>
            <p>@Html.ActionLink("Ver bitácora", "ListarEventos", "Bitacora", null, new { @class = "btn btn-outline-dark" })</p>
        </section>
    </div>
</main>
