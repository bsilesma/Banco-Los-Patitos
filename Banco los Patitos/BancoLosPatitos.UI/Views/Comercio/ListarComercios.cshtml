@model List<BancoLosPatitos.Abstracciones.ModelosParaUI.ComercioDto>

@{
    ViewBag.Title = "Comercios";
}

<h2>Comercios</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="mb-3">
    @Html.ActionLink(
        "Registrar comercio",
        "RegistrarComercio",
        "Comercio",
        null,
        new { @class = "btn btn-primary btn-sm" }
    )
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Identificación</th>
                <th>Tipo de identificación</th>
                <th>Nombre</th>
                <th>Tipo de comercio</th>
                <th>Teléfono</th>
                <th>Correo electrónico</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center">No hay comercios registrados.</td>
                </tr>
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Identificacion</td>
                    <td>@item.TipoIdentificacionTexto</td>
                    <td>@item.Nombre</td>
                    <td>@item.TipoDeComercioTexto</td>
                    <td>@item.Telefono</td>
                    <td>@item.CorreoElectronico</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">@item.EstadoTexto</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.EstadoTexto</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        @Html.ActionLink(
                            "Editar",
                            "EditarComercio",
                            "Comercio",
                            new { id = item.IdComercio },
                            new { @class = "btn btn-warning btn-sm" }
                        )

                        @Html.ActionLink(
                            "Detalles",
                            "DetallesComercio",
                            "Comercio",
                            new { id = item.IdComercio },
                            new { @class = "btn btn-info btn-sm" }
                        )

                        @Html.ActionLink(
                            "Ver cajas",
                            "ListarCajas",
                            "Caja",
                            new { idComercio = item.IdComercio },
                            new { @class = "btn btn-secondary btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
