@model BancoLosPatitos.Abstracciones.ModelosParaUI.ComercioDto

@{
    ViewBag.Title = "Editar comercio";
}

<h2>Editar comercio</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@using (Html.BeginForm(
    "EditarComercio",
    "Comercio",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.IdComercio)
    @Html.HiddenFor(model => model.Identificacion)
    @Html.HiddenFor(model => model.TipoIdentificacion)

    <p><strong>Identificación:</strong> @Model.Identificacion</p>
    <p><strong>Tipo de identificación:</strong> @Model.TipoIdentificacionTexto</p>

    <div class="mb-3">
        @Html.LabelFor(model => model.Nombre, "Nombre", new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", maxlength = "200", data_validar = "texto" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.TipoDeComercio, "Tipo de comercio", new { @class = "form-label" })
        @Html.DropDownListFor(
            model => model.TipoDeComercio,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "Restaurantes", Value = "1" },
                new SelectListItem { Text = "Supermercados", Value = "2" },
                new SelectListItem { Text = "Ferreterías", Value = "3" },
                new SelectListItem { Text = "Otros", Value = "4" }
            },
            "-- Seleccione un tipo --",
            new { @class = "form-select", data_validar = "seleccion" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Telefono, "Teléfono", new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Telefono, new { @class = "form-control", maxlength = "8", data_validar = "telefono" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.CorreoElectronico, "Correo electrónico", new { @class = "form-label" })
        @Html.TextBoxFor(model => model.CorreoElectronico, new { @class = "form-control", maxlength = "200", data_validar = "correo" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Direccion, "Dirección", new { @class = "form-label" })
        @Html.TextAreaFor(model => model.Direccion, new { @class = "form-control", maxlength = "500", rows = "3", data_validar = "texto" })
    </div>

    <div class="form-check mb-3">
        @Html.CheckBoxFor(model => model.Estado, new { @class = "form-check-input" })
        @Html.LabelFor(model => model.Estado, "Activo", new { @class = "form-check-label" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>

    @Html.ActionLink(
        "Volver",
        "ListarComercios",
        "Comercio",
        null,
        new { @class = "btn btn-secondary" }
    )
}
