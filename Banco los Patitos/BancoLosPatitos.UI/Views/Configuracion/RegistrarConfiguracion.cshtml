@model BancoLosPatitos.Abstracciones.ModelosParaUI.ConfiguracionDto

@{
    ViewBag.Title = "Registrar configuración";
}

<h2>Registrar configuración</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (((SelectList)ViewBag.Comercios).Count() == 0)
{
    <div class="alert alert-info">
        Todos los comercios activos ya tienen una configuración registrada.
    </div>
}

@using (Html.BeginForm(
    "RegistrarConfiguracion",
    "Configuracion",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(model => model.IdComercio, "Comercio", new { @class = "form-label" })
        @Html.DropDownListFor(
            model => model.IdComercio,
            (SelectList)ViewBag.Comercios,
            "-- Seleccione un comercio --",
            new { @class = "form-select", data_validar = "seleccion" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.TipoConfiguracion, "Tipo de configuración", new { @class = "form-label" })
        @Html.DropDownListFor(
            model => model.TipoConfiguracion,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "Plataforma", Value = "1" },
                new SelectListItem { Text = "Externa", Value = "2" },
                new SelectListItem { Text = "Ambas", Value = "3" }
            },
            "-- Seleccione un tipo --",
            new { @class = "form-select", data_validar = "seleccion" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Comision, "Comisión (%)", new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Comision, new { @class = "form-control", maxlength = "3", data_validar = "porcentaje" })
    </div>

    <button type="submit" class="btn btn-primary">Registrar</button>

    @Html.ActionLink(
        "Volver",
        "ListarConfiguraciones",
        "Configuracion",
        null,
        new { @class = "btn btn-secondary" }
    )
}
