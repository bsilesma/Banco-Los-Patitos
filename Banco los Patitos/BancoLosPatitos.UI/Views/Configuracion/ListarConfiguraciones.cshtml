@model List<BancoLosPatitos.Abstracciones.ModelosParaUI.ConfiguracionDto>

@{
    ViewBag.Title = "Configuraciones de comercio";
}

<h2>Configuraciones de comercio</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="mb-3">
    @Html.ActionLink(
        "Registrar configuración",
        "RegistrarConfiguracion",
        "Configuracion",
        null,
        new { @class = "btn btn-primary btn-sm" }
    )

    @Html.ActionLink(
        "Volver a comercios",
        "ListarComercios",
        "Comercio",
        null,
        new { @class = "btn btn-secondary btn-sm" }
    )
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Nombre del comercio</th>
                <th>Tipo de configuración</th>
                <th>Comisión</th>
                <th>Fecha de registro</th>
                <th>Fecha de modificación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center">No hay configuraciones registradas.</td>
                </tr>
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreDelComercio</td>
                    <td>@item.TipoConfiguracionTexto</td>
                    <td>@item.Comision %</td>
                    <td>@item.FechaDeRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>
                        @if (item.FechaDeModificacion.HasValue)
                        {
                            @item.FechaDeModificacion.Value.ToString("dd/MM/yyyy hh:mm tt")
                        }
                        else
                        {
                            <span class="text-muted">Sin modificar</span>
                        }
                    </td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">@item.EstadoTexto</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.EstadoTexto</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        @Html.ActionLink(
                            "Editar",
                            "EditarConfiguracion",
                            "Configuracion",
                            new { id = item.IdConfiguracion },
                            new { @class = "btn btn-warning btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
